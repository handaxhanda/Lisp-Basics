;; defunで関数を定義する。squareは関数名、(x)は引数の一覧。
(defun square (x)
  ;; Lispでは「処理名 → 引数」の順に書く。(* x x)は「x × x」。
  ;; 関数は最後に評価した式の結果を返すので、returnは不要。
  (* x x))

;; formatは、文字列や値を指定した形式で出力する関数。
;; tは「真」を表す記号だが、ここでは標準出力への出力を指定する。
;; 文字列中の ~% は改行を指示する。
(format t "Hello , Common Lisp!~%")

;; (+ 1 2 3)を先に評価し、その結果の6を ~a の位置に埋め込む。
;; ~aのaはAestheticに由来し、値を人が読みやすい形で表示する。
(format t "1 + 2 + 3 = ~a~%" (+ 1 2 3))

;; 関数呼び出しも「(関数名 引数)」と書く。(square 5)の結果は25。
;; 文字列内のsquare(5)は表示用の文章で、Lispの構文ではない。
(format t "square(5) = ~a~%" (square 5))
